<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>@ViewData["Title"] · SAT / DTE</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<aside class="sidebar">
    <a class="brand" asp-page="/Index"><span class="brand-icon">D</span><span>SAT / DTE<small>Laboratorio tributario</small></span></a>
    <div class="nav-label">ESPACIO DE TRABAJO</div>
    <nav aria-label="Navegación principal">
        <a asp-page="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"><span>◈</span> Inicio</a>
        <a asp-page="/Enviar" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Enviar" ? "active" : "")"><span>↥</span> Enviar mensaje</a>
        <a asp-page="/Peticiones" class="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Peticiones" ? "active" : "")"><span>▤</span> Peticiones y reportes</a>
        <a asp-page="/Ayuda"><span>?</span> Ayuda</a>
    </nav>
    <div class="sidebar-foot"><span class="pill">PROYECTO 03</span><p>Introducción a la Programación<br />y Computación 2</p><small>USAC · Segundo semestre 2026</small></div>
</aside>
<div class="workspace"><header class="topbar"><span>Servicio de autorización electrónica</span><span class="academic">SIMULADOR ACADÉMICO</span></header>
<main id="contenido">@RenderBody()</main><footer>William René Toledo Corado · 202210198 · Sección B</footer></div>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
